{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O-RAN pre-action trust contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "incident_id",
    "requested_at",
    "agent",
    "action",
    "interface",
    "target",
    "parameters",
    "risk_level",
    "ttl_seconds",
    "expected_kpi",
    "rollback",
    "evidence_refs",
    "approval"
  ],
  "properties": {
    "action_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "incident_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requested_at": {"type": "string", "format": "date-time"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "action": {
      "enum": [
        "rate_limit_ue",
        "quarantine_ue",
        "isolate_xapp",
        "modify_a1_policy",
        "rollback_policy",
        "notify_operator"
      ]
    },
    "interface": {"enum": ["E2", "A1", "SMO"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_id", "cell_id", "slice_id"],
      "properties": {
        "target_type": {"enum": ["ue", "xapp", "policy", "cell", "operator"]},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "cell_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "slice_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16
    },
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "expected_kpi": {"type": "string", "minLength": 1, "maxLength": 256},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "procedure"],
      "properties": {
        "available": {"type": "boolean"},
        "procedure": {"type": "string", "maxLength": 512}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_id", "approved_by_role", "expires_at"],
          "properties": {
            "approval_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "approved_by_role": {"const": "human_operator"},
            "expires_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  }
}
